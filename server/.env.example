# A non-loopback DOCKLITE_HOST forces login AND refuses to start while the
# built-in admin password is active — set DOCKLITE_ADMIN_PASSWORD first.
# It is read only when the admin is seeded; delete server/data/auth-config.json
# to re-seed an existing install.
DOCKLITE_HOST=127.0.0.1
DOCKLITE_PORT=9001
DOCKLITE_DOCKER_SOCKET=/var/run/docker.sock
DOCKLITE_ADAPTER=real
